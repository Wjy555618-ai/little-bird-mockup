  "deploymentGates": [
    { "id": "RC-G01", "name": "合同与摘要", "blocking": true, "evidenceRequired": "当前合同校验与来源摘要一致" },
    { "id": "RC-G02", "name": "域名与 TLS", "blocking": true, "evidenceRequired": "自定义域名、证书、DNS 所有权和无重定向 manifest" },
    { "id": "RC-G03", "name": "数据平面隔离", "blocking": true, "evidenceRequired": "公开部署清单不含质检台、测试库、源码、参考图或凭据" },
    { "id": "RC-G04", "name": "远程字节一致", "blocking": true, "evidenceRequired": "manifest 与全部活动资源的 MIME、字节数和 SHA-256" },
    { "id": "RC-G05", "name": "原子激活", "blocking": true, "evidenceRequired": "部分上传和并发读取时旧 manifest 始终可用" },
    { "id": "RC-G06", "name": "缓存与故障降级", "blocking": true, "evidenceRequired": "在线、超时、断网、有效缓存、过期缓存和无缓存真实插件证据" },
    { "id": "RC-G07", "name": "真实远程回滚", "blocking": true, "evidenceRequired": "发现不超过 5 分钟且恢复不超过 15 分钟" },
    { "id": "RC-G08", "name": "隐私与安全", "blocking": true, "evidenceRequired": "无用户设计上传、远程代码、未声明域名或写凭据" },
    { "id": "RC-G09", "name": "运营责任", "blocking": true, "evidenceRequired": "监控、告警、责任人、支持入口和事故记录位置" },
    { "id": "RC-G10", "name": "供应商与撤回取舍", "blocking": true, "evidenceRequired": "供应商、费用、地区、日志保留和撤回窗口的人工决定记录" }
  ],
  "pilotDeploymentGates": [
    { "id": "P0-G01", "name": "合同与候选摘要", "blocking": true, "evidenceRequired": "阶段零合同、活动文件白名单和候选 SHA-256 一致" },
    { "id": "P0-G02", "name": "精确 Netlify 来源", "blocking": true, "evidenceRequired": "唯一固定 HTTPS netlify.app origin；禁止通配域名和重定向 manifest" },
    { "id": "P0-G03", "name": "公开面隔离", "blocking": true, "evidenceRequired": "线上仅有 manifest、活动 revision 媒体和响应头；无旧 revision、批准文件、质检台、源码或凭据" },
    { "id": "P0-G04", "name": "远程字节一致", "blocking": true, "evidenceRequired": "manifest 与全部活动媒体的状态、MIME、字节数和 SHA-256" },
    { "id": "P0-G05", "name": "缓存与 CORS", "blocking": true, "evidenceRequired": "manifest no-store、活动媒体 immutable、CORS 和 nosniff 实测" },
    { "id": "P0-G06", "name": "真实 Figma 闭环", "blocking": true, "evidenceRequired": "真实 Figma 中在线加载、换画面、编辑、导出、粘贴、断网缓存和失败保留状态" },
    { "id": "P0-G07", "name": "手动部署可追溯", "blocking": true, "evidenceRequired": "无 Git 连接的 Netlify 站点、部署 ID、固定 URL、候选摘要和执行时间" },
    { "id": "P0-G08", "name": "免费额度保护", "blocking": true, "evidenceRequired": "Free 计划硬额度已确认，监控入口已记录且未启用自动付费" }
