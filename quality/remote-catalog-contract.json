    "remoteResourceChecks": ["status-200", "content-type", "content-length", "sha256"],
    "manifestChecks": ["no-redirect", "content-type", "byte-equality", "schema", "environment", "renderer", "minimum-plugin-version"]
  },
  "failurePolicy": {
    "invalidManifest": "reject-new-and-retain-current-valid-catalog",
    "missingOrInvalidAsset": "preserve-current-selection-and-user-state-without-partial-commit",
    "timeoutOrOffline": "use-same-origin-valid-cache-within-age-limit",
    "noValidCache": "show-actionable-error-and-preserve-user-design-state",
    "crossOriginOrRedirect": "reject",
    "partialDeployment": "old-manifest-remains-active"
  },
  "rollback": {
    "dryRunByDefault": true,
    "explicitApplyRequired": true,
    "restoreAsNewMonotonicCatalogVersion": true,
    "immutableResourcesNeverOverwritten": true,
    "maximumDetectionMinutes": 5,
    "maximumRecoveryMinutes": 15,
    "requiredFaults": [
      "bad-manifest",
      "missing-asset",
      "wrong-sha256",
      "timeout",
      "provider-outage",
      "partial-upload",
      "wrong-content-type",
      "unexpected-redirect",
      "dns-or-certificate-failure"
    ]
  },
